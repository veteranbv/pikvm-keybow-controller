# PiKVM Keybow Controller Configuration
# Copy to .env and fill in your values

# PiKVM Connection
PIKVM_HOST=https://pikvm.example.net
PIKVM_USER=admin
PIKVM_PASS=your-password-here

# Switch Configuration
TOTAL_PORTS=8

# Optional: public CA certificates for a private issuer (PEM format).
# The certificate must match the hostname in PIKVM_HOST.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/pikvm-ca.pem
