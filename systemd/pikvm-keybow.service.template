[Unit]
Description=PiKVM Keybow Mini Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/venv/bin/python {{INSTALL_DIR}}/pikvm_keybow.py
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pikvm-keybow

[Install]
WantedBy=multi-user.target
